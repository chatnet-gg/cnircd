/*
 * ChatNet -- template ircd.conf for linking your own cnircd server
 * (https://github.com/chatnet-gg/cnircd, ChatNet's own Solanum fork)
 * into the network as a leaf. Fill in the <<-- ... --> placeholders
 * (the SID/host/password you were given by the ChatNet admin, plus
 * your own local server details) and nothing else needs to change.
 *
 * This file holds ONLY what is local to your server. Everything that must be identical on every ChatNet server
 * (modules, privsets, aliases, services, channel and general settings, DNSBLs) lives in chatnet-common.conf and
 * chatnet-clients.conf, which are included below: copy those two files next to this one and do not edit them, so a
 * later `git pull` of the standard reaches you without a merge.
 *
 * See https://chatnet.gg/routing.html for the full step-by-step guide.
 *
 * Based on Solanum's own example config, adapted for ChatNet and
 * maintained by abcX (abcx@chatnet.gg) and bitmaster (bitmaster@chatnet.gg), and tested on
 * live leaves by w0od, TGS and Astro. Every change to this template is
 * checked against the configs the production leaves run before it
 * ships; see README.chatnet.md for the patches and extensions this
 * build carries.
 *
 * Thanks and credits to all the ChatNet admins and operators, and to
 * everyone who has worked on the ChatNet ircd over the years.
 *
 * Questions about linking: ChatNet Routing, via the page above.
 */

/* The ChatNet standard -- identical on every server. Do not edit these two files. */
.include "chatnet-common.conf"
.include "chatnet-clients.conf"

modules {
	path = "modules";
	path = "modules/autoload";
};

serverinfo {
	name = "<<-- your-assigned-name.chatnet.gg -->>";
	sid = "<<-- SID given to you by the ChatNet admin, e.g. 43B -->>";
	description = "<<-- short description of your server -->>";
	network_name = "ChatNet";
	default_max_clients = 1024;
	nicklen = 30;

	/* Required even without real TLS listeners -- without a cert file
	 * present, solanum's ssld helper aborts startup on some builds. */
	ssl_cert = "etc/ssl.pem";
	ssl_dh_params = "etc/dh.pem";
	ssld_count = 1;
};

admin {
	name = "<<-- your name/handle -->>";
	description = "<<-- your server's description -->>";
	email = "<<-- your contact email -->>";
};

log {
	fname_userlog = "logs/userlog";
	fname_operlog = "logs/operlog";
	fname_serverlog = "logs/serverlog";
	fname_killlog = "logs/killlog";
	fname_operspylog = "logs/operspylog";
};

/* Connection classes. On ChatNet these are the same from server to
 * server -- the values below are the ones every production leaf runs.
 * "users" is the one you may tune for your own box (max_number is how
 * many clients your server will carry); leave "opers" and "server"
 * alone. */
class "users" {
	ping_time = 2 minutes;
	number_per_ident = 15;
	number_per_ip = 15;
	number_per_ip_global = 20;
	cidr_ipv4_bitlen = 24;
	cidr_ipv6_bitlen = 64;
	number_per_cidr = 25;
	max_number = 3000;
	sendq = 400 kbytes;
};

class "opers" {
	ping_time = 5 minutes;
	number_per_ip = 10;
	max_number = 100;
	sendq = 1 megabyte;
};

class "server" {
	ping_time = 5 minutes;
	connectfreq = 30 seconds;
	max_number = 8;
	max_autoconn = 1;
	sendq = 4 megabytes;
};

/* Only needed if you want real users connecting directly to YOUR
 * server. Omit entirely if this leaf only exists to extend the
 * network topology, with no local users. sslport requires
 * serverinfo::ssl_cert/ssl_dh_params above (already set) -- pairs with
 * the cap_sts module above, which advertises this port to clients. */
listen {
	defer_accept = yes;
	port = 6667;
	sslport = 6697;
};

/* Per-host connection limit exceptions, written by the cn_clone_except
 * module. This MUST come before the first auth{} block (earlier = higher
 * precedence). Create the file first:  cp exempt-cw.conf.sample exempt-cw.conf */
.include "exempt-cw.conf"

auth {
	user = "*@*";
	class = "users";
	flags = exceed_limit;
};

/* The link details (hub address, your SID and the link password) are
 * sent to you privately by ChatNet Routing when your link is approved;
 * nothing in this file gives you a way to link on your own.
 *
 * ChatNet's public entry point, irc.chatnet.gg -- NOT the network's
 * internal hub. Your server dials OUT to it (flags = autoconn), it
 * only accepts the connection. */
connect "irc.chatnet.gg" {
	host = "<<-- irc.chatnet.gg's public IP, given to you by the ChatNet admin -->>";
	send_password = "<<-- password given to you by the ChatNet admin -->>";
	accept_password = "<<-- same password -->>";
	port = 7000;
	class = "server";
	flags = autoconn;
};

/* Every ChatNet service nick (NickServ/K9/OS/ChatWorld/etc) is under a
 * permanent, network-wide RESV -- it's set once on any linked server and
 * propagates to every other server on burst, including yours the moment
 * you link in. Don't try to add your own local resv{} for these; there's
 * no such static block in Solanum, and it would just be redundant with
 * what's already enforced network-wide. */

/* ROUTING O:lines -- requested on every server that links into
 * ChatNet, purely for network routing purposes (so our admins can
 * oper up on any linked server if a link needs to be fixed, squit,
 * or rerouted). Local to your server only per Solanum's own model --
 * does not grant anything on the rest of ChatNet by itself. The
 * ChatNet admin will give you these five password hashes privately
 * (same on every leaf network-wide) -- paste them in exactly as given,
 * do not generate your own.
 *
 * If you are linking into ChatNet, don't edit the routing O:lines.
 * They don't make anyone a regular operator of your server: they are
 * there so Routing can fix a link. Only change their privileges if you,
 * as the server admin, are taking responsibility for that person as an
 * operator on your server -- you are accountable for what the operators
 * you appoint do. */
operator "abcX" {
	user = "*@*";
	password = "<<-- password hash given to you privately by the ChatNet admin -->>";
	flags = encrypted;
	privset = "admin";
};

operator "w0od" {
	user = "*@*";
	password = "<<-- password hash given to you privately by the ChatNet admin -->>";
	flags = encrypted;
	privset = "admin";
};

operator "bitmaster" {
	user = "*@*";
	password = "<<-- password hash given to you privately by the ChatNet admin -->>";
	flags = encrypted;
	privset = "admin";
};

operator "TGS" {
	user = "*@*";
	password = "<<-- password hash given to you privately by the ChatNet admin -->>";
	flags = encrypted;
	privset = "admin";
};

operator "Astro" {
	user = "*@*";
	password = "<<-- password hash given to you privately by the ChatNet admin -->>";
	flags = encrypted;
	privset = "admin";
};

/* Local IRCop on YOUR server only -- grants nothing network-wide.
 * Pick your own password, not shared with the ChatNet admin. */
operator "<<-- your local oper name -->>" {
	user = "*@*";
	password = "<<-- choose your own password -->>";
	flags = ~encrypted;
};
